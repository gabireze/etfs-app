{
  "name": "etfs-app",
  "version": "1.0.0",
  "description": "Simulador de Carteira de ETFs Brasil - Análise de rentabilidade com dados da B3",
  "author": {
    "name": "Gabriel de Rezende Gonçalves",
    "email": "contato@gabireze.com.br",
    "url": "https://gabireze.com.br"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabireze/etfs-app.git"
  },
  "homepage": "https://github.com/gabireze/etfs-app#readme",
  "bugs": {
    "url": "https://github.com/gabireze/etfs-app/issues"
  },
  "keywords": [
    "etfs",
    "b3",
    "investment",
    "portfolio",
    "angular",
    "brazil",
    "brapi"
  ],
  "scripts": {
    "ng": "ng",
    "start": "node scripts/load-env.js && ng serve",
    "build": "ng build --configuration production",
    "build:dev": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "env:dev": "node scripts/load-env.js",
    "env:clean": "git restore src/environments/environment.ts src/environments/environment.prod.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.1",
    "chart.js": "^4.5.1",
    "express": "^5.1.0",
    "ng2-charts": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "autoprefixer": "^10.4.23",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
